<link href="http://www.madrid.es/sites/v/index.jsp?vgnextchannel=bfa48ab43d6bb410VgnVCM100000171f5a0aRCRD&amp;vgnextoid=255aef4d7f71c010VgnVCM1000000b205a0aRCRD" type="text/html" rel="alternate"/>
