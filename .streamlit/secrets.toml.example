# Copia este fichero a .streamlit/secrets.toml (NO se sube a git) o pega su contenido en
# "Advanced settings → Secrets" de Streamlit Community Cloud. Ambos valores son opcionales.

ORS_API_KEY = ""     # clave de OpenRouteService: sin ella se usa el servidor público (FOSSGIS) y se pierde algo de altimetría
APP_PASSWORD = ""    # si la rellenas, la app pide contraseña al entrar (útil para una demo con jurado)
